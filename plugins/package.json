{
  "name": "@all-in-one-mcp/plugins",
  "version": "0.1.0",
  "description": "TypeScript plugins and lifecycle hooks for all-in-one-mcp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./file-guard": {
      "types": "./dist/file-guard.d.ts",
      "default": "./dist/file-guard.js"
    },
    "./bridge": {
      "types": "./dist/bridge/subprocess.d.ts",
      "default": "./dist/bridge/subprocess.js"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "default": "./dist/clients/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/lifecycle.d.ts",
      "default": "./dist/hooks/lifecycle.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --experimental-strip-types --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.31"
  }
}
